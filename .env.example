# Optional AI explanations. The platform works without either key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Docker Compose defaults to its local MySQL database and these values.
# Change these before exposing the stack beyond your machine.
SPRING_PROFILES_ACTIVE=prod
MYSQL_ROOT_PASSWORD=change-me-local-root
MYSQL_PASSWORD=change-me-local-app
