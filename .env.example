# ===================================================================
# BrandShield AI — Environment Configuration
# ===================================================================

# --- Google Gemini AI API Configuration ---
# Insert your Google AI Gemini API key here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Alternative: OpenAI API Configuration ---
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# --- Application Runtime Mode ---
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173

# --- Optional MySQL Database Configuration (defaults to H2 in-memory when using -Dspring.profiles.active=dev) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=brandshield
DB_USER=root
DB_PASS=
